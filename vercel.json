{
  "version": 2,
  "buildCommand": "cd angularapp && npm install && NODE_OPTIONS=--openssl-legacy-provider npm run build",
  "outputDirectory": "angularapp/dist/angularapp",
  "build": {
    "env": {
      "NODE_OPTIONS": "--openssl-legacy-provider"
    }
  },
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
